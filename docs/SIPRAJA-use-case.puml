' USE CASE SIPRAJA
' Pilih SATU blok @startuml ... @enduml untuk disalin ke editor PlantUML.
' Berkas draw.io pendamping berisi objek native yang bisa diedit.

@startuml SIPRAJA_1
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
  BackgroundColor #EFF6FF
  BorderColor #2563EB
}
title Use Case SIPRAJA - Pelapor
actor "Pelapor" as ACTOR0
rectangle "SIPRAJA / Pelapor" {
  usecase "P01\nMengirim laporan masyarakat" as P01
  usecase "P02\nMelihat status laporan sendiri" as P02
  usecase "P03\nMemberi feedback penanganan" as P03
}
ACTOR0 -- P01
ACTOR0 -- P02
ACTOR0 -- P03
P03 ..> P02 : <<extend>>\n[selesai dan belum feedback]
@enduml

