ourier New;" vertex="1" parent="1"><mxGeometry x="1370" y="274" width="560" height="37" as="geometry" /></mxCell><mxCell id="ReportSource" value="«enumeration» ReportSource" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f3e8ff;strokeColor=#475569;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="610" width="560" height="64" as="geometry" /></mxCell><mxCell id="ReportSource_attrs" value="Online = online Offline = offline" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#475569;align=left;verticalAlign=top;spacing=9;fontSize=13;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="70" y="674" width="560" height="60" as="geometry" /></mxCell><mxCell id="ReportSource_methods" value="+ label(): string" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#475569;align=left;verticalAlign=top;spacing=8;fontSize=13;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="70" y="734" width="560" height="37" as="geometry" /></mxCell><mxCell id="ReportSourcePlatform" value="«enumeration» ReportSourcePlatform" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f3e8ff;strokeColor=#475569;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="610" width="560" height="64" as="geometry" /></mxCell><mxCell id="ReportSourcePlatform_attrs" value="Website = website WhatsApp = whatsapp Instagram = instagram X = x Facebook = facebook TikTok = tiktok Other = other" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#475569;align=left;verticalAlign=top;spacing=9;fontSize=13;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="720" y="674" width="560" height="165" as="geometry" /></mxCell><mxCell id="ReportSourcePlatform_methods" value="+ label(): string" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#475569;align=left;verticalAlign=top;spacing=8;fontSize=13;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="720" y="839" width="560" height="37" as="geometry" /></mxCell><mxCell id="ReportStatus" value="«enumeration» ReportStatus" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f3e8ff;strokeColor=#475569;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1370" y="610" width="560" height="64" as="geometry" /></mxCell><mxCell id="ReportStatus_attrs" value="Submitted = submitted Received = received Verifying = verifying InProgress = in_progress Completed = completed" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#475569;align=left;verticalAlign=top;spacing=9;fontSize=13;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1370" y="674" width="560" height="123" as="geometry" /></mxCell><mxCell id="ReportStatus_methods" value="+ label(): string + description(): string + nextProcessingStatus(): ?self" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#475569;align=left;verticalAlign=top;spacing=8;fontSize=13;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1370" y="797" width="560" height="79" as="geometry" /></mxCell><mxCell id="ReportCategory" value="«enumeration» ReportCategory" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f3e8ff;strokeColor=#475569;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="1070" width="560" height="64" as="geometry" /></mxCell><mxCell id="ReportCategory_attrs" value="PublicOrder = public_order EnvironmentalCleanliness = environmental_cleanliness Security = security" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#475569;align=left;verticalAlign=top;spacing=9;fontSize=13;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="70" y="1134" width="560" height="81" as="geometry" /></mxCell><mxCell id="ReportCategory_methods" value="+ label(): string" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeC