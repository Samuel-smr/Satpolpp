1" as="geometry" /></mxCell><mxCell id="Asset_methods" value="+ createdByUser(): BelongsTo&lt;User&gt; + vehicleAlerts(): Collection {static} # casts(): array" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#475569;align=left;verticalAlign=top;spacing=8;fontSize=13;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1650" y="1285" width="560" height="58" as="geometry" /></mxCell><mxCell id="note" value="DatabaseNotification merupakan class Laravel; User memakai trait Notifiable. Archive adalah folder metadata dengan maksimal tiga ArchiveFile. AuditLog.subject_type/subject_id hanya metadata tanpa morphTo/FK subjek. AuditLog tidak memiliki updated_at. Servis oli kendaraan menyimpan kilometer berikutnya dan tanggal servis terakhir." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="35" y="1373" width="2210" height="110" as="geometry" /></mxCell><mxCell id="ArchiveFile" value="«model» ArchiveFile&#xA;archive_files" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dbeafe;strokeColor=#475569;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="150" width="560" height="64" as="geometry" /></mxCell><mxCell id="ArchiveFile_attrs" value="id: bigint {PK}&#xA;archive_id: bigint {FK}&#xA;file_path: string&#xA;original_name: string&#xA;mime_type: string&#xA;file_extension: string&#xA;file_size: bigint&#xA;created_at: DateTime?&#xA;updated_at: DateTime?" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#475569;align=left;verticalAlign=top;spacing=9;fontSize=13;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="700" y="214" width="560" height="228" as="geometry" /></mxCell><mxCell id="ArchiveFile_methods" value="+ archive(): BelongsTo&lt;Archive&gt;&#xA;# casts(): array" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#475569;align=left;verticalAlign=top;spacing