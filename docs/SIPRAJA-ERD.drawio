        <mxCell id="session-note" value="sessions.user_id adalah indeks biasa, tanpa foreign key dalam migrasi.&#10;Sesi juga menyimpan pilihan tahun, status verifikasi OTP, dan percakapan AI.&#10;OTP/kode rate limit disimpan lewat cache; bukan password_reset_tokens." style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontFamily=Arial;fontSize=14;fontColor=#334155;fillColor=#EFF6FF;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="480" width="1210" height="160" />
        </mxCell>
        <mxCell id="reset-note" value="password_reset_tokens masih dibuat oleh migrasi dan dirujuk config/auth.php.&#10;Belum ada alur lupa password email di SIPRAJA.&#10;Ganti password lewat Profil/Manajemen User langsung memperbarui users.password." style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontFamily=Arial;fontSize=14;fontColor=#334155;fillColor=#FFFBEB;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1420" y="480" width="790" height="160" />
        </mxCell>
        <mxCell id="framework-note" value="CATATAN INFRASTRUKTUR&#10;Tidak ada FK antar jobs, job_batches, dan failed_jobs pada migrasi. Jangan menggambar relasi fisik yang tidak didefinisikan.&#10;Queue/cache/session mengikuti driver konfigurasi; keberadaan tabel tidak membuktikan ada job atau reset token aktif.&#10;Tabel migrations adalah pencatat migrasi framework dan tidak dimasukkan sebagai entitas bisnis." style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontFamily=Arial;fontSize=14;fontColor=#334155;fillColor=#EFF6FF;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1250" width="2150" height="170" />
        </mxCell>
