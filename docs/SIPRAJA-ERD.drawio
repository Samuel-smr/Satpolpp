        <mxCell id="edge-caption-1" value="archive_id [CASCADE]" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=12;fontStyle=0;fontColor=#334155;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1">
