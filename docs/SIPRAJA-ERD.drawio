        <mxCell id="archive-rules" value="ARSIP&#10;Skema: 0..N file per arsip. Form: 1–5 file; maksimal 20 MB per file.&#10;Kategori disimpan pada operational_category (varchar 150).&#10;Arsip baru hanya untuk tahun berjalan. Daftar/akses mengikuti created_at.&#10;IDX: created_at dan (operational_category,created_at)." style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontFamily=Arial;fontSize=14;fontColor=#334155;fillColor=#FFFBEB;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="760" width="450" height="300" />
        </mxCell>
        <mxCell id="audit-rules" value="AUDIT&#10;subject_type + subject_id adalah referensi logis, bukan FK / morphTo model.&#10;old_values/new_values hanya field yang dipilih controller, bukan semua kolom.&#10;IDX: created_at; (module,created_at); (subject_type,subject_id)." style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontFamily=Arial;fontSize=14;fontColor=#334155;fillColor=#FFFBEB;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="680" y="1190" width="530" height="150" />
        </mxCell>
        <mxCell id="notification-rules" value="NOTIFIKASI&#10;Penerima laporan baru: Admin/Super Admin aktif.&#10;Payload data berupa text pada skema, dibaca sebagai array oleh model Laravel.&#10;Tahun tampilan dan jumlah belum dibaca mengikuti created_at.&#10;Notifikasi database terpisah dari pengiriman WhatsApp." style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontFamily=Arial;fontSize=14;fontColor=#334155;fillColor=#EFF6FF;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="1210" width="600" height="170" />
        </mxCell>
        <mxCell id="edge-caption-0" value="created_by_user_id&#10;[RESTRICT]" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=12;fontStyle=0;fontColor=#334155;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1">
