        <mxCell id="user-rule" value="BATAS MANAJEMEN USER&#10;Akun baru selalu role Admin, status aktif.&#10;Nomor WhatsApp opsional untuk notifikasi laporan baru.&#10;Akun yang sedang digunakan tidak dapat diblokir/dihapus.&#10;Mengubah password akun tidak memakai token reset email." style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontFamily=Arial;fontSize=14;fontColor=#334155;fillColor=#FFFBEB;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="440" width="470" height="235" />
        </mxCell>
        <mxCell id="monitor-rule" value="DASHBOARD DAN MONITORING&#10;Peta hanya untuk data berkoordinat dan tahun terpilih.&#10;Laporan/Aduan mencakup kegiatan eksternal; kategori lain Kegiatan Internal.&#10;Audit menampilkan aksi yang benar-benar dicatat controller, bukan semua klik/CRUD.&#10;Kartu status layanan bukan pemeriksaan kesehatan server otomatis." style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontFamily=Arial;fontSize=14;fontColor=#334155;fillColor=#EFF6FF;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="750" width="470" height="260" />
        </mxCell>
        <mxCell id="directory-rule" value="DIREKTORI BACA-SAJA&#10;Koreksi nama/NIP/jabatan dilakukan pada e-Profil.&#10;Kemunculan pegawai tidak otomatis membuat akun login.&#10;Kegagalan API menampilkan peringatan; tidak membuat master lokal." style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontFamily=Arial;fontSize=14;fontColor=#334155;fillColor=#FFFBEB;strokeColor=#CBD5E1;" vertex="1" parent="1">
