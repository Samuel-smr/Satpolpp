<mxfile host="app.diagrams.net" version="24.7.17" type="device" modified="2026-10-27T00:00:00.000Z">
  <diagram id="ai" name="01 - Asisten AI">
    <mxGraphModel dx="1500" dy="900" grid="1" page="1" pageWidth="1800" pageHeight="1300">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="SEQUENCE 01 — ASISTEN AI PADA HALAMAN LAPOR" style="text;html=0;fontSize=25;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a" value="Pelapor" style="rounded=1;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="b" value="UI Lapor" style="rounded=1;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="130" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c" value="AiAssistantController" style="rounded=1;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="130" width="240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="d" value="GeminiAssistant" style="rounded=1;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="130" width="210" height="55" as="geometry" />
        </mxCell>
        <mxCell id="e" value="Gemini API" style="rounded=1;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1360" y="130" width="190" height="55" as="geometry" />
        </mxCell>
        <mxCell id="box" value="1. Browser mengirim message saja (maks. 600 karakter)&#10;2. Validasi menolak history/model/tools browser; throttle + session lock&#10;3. Server mengambil riwayat sesi: maks. 8 pesan, &lt;30 menit tidak aktif&#10;4. Service meredaksi pola sensitif; memakai konfigurasi API server&#10;5. Gemini menjawab; controller menyimpan riwayat terbaru&#10;6. JSON answer berupa teks biasa; pengiriman laporan oleh warga&#10;Alternatif: rate limit 429; provider gagal/AI nonaktif -&gt; 503 pesan aman" style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=16;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="160" y="280" width="1280" height="340" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="message" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" edge="1" parent="1" source="a" target="b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="POST /lapor/asisten-ai" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" edge="1" parent="1" source="b" target="c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="ask(message, serverHistory)" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" edge="1" parent="1" source="c" target="d">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="generateContent" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" edge="1" parent="1" source="d" target="e">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="report" name="02 - Laporan">
    <mxGraphModel dx="1500" dy="900" grid="1" page="1" pageWidth="1800" pageHeight="1300">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
