          <mxGeometry x="40" y="20" width="1100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a" value="Pelapor" style="rounded=1;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="130" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="b" value="PelaporController" style="rounded=1;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="390" y="130" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c" value="Database" style="rounded=1;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="130" width="190" height="55" as="geometry" />
        </mxCell>
        <mxCell id="d" value="Admin penanggung jawab" style="rounded=1;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="130" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="e" value="CompleteReportController" style="rounded=1;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1370" y="130" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="box" value="1. Minta/verifikasi OTP WhatsApp pada sesi browser&#10;2. POST /lapor: telepon, deskripsi, alamat, foto?, persetujuan&#10;3. Transaksi Report lapor/submitted, GuestAccess, history, lampiran&#10;4. Notifikasi DB Admin/Super Admin; WhatsApp pelapor/Admin aktif&#10;5. Super Admin menugaskan Admin aktif pada tahun terpilih; audit&#10;6. Gate: hanya penanggung jawab proses submitted -&gt; received -&gt; verifying&#10;7. Alternatif verifying -&gt; rejected + alasan; lanjut -&gt; in_progress&#10;8. Validasi NIP API e-Profil, tanggal tahun terpilih, hasil, lokasi, foto&#10;9. Transaksi Activity external + activity_personnel + foto + completed + audit&#10;10. WhatsApp hasil/SKM; warga melihat status token dan menilai sekali" style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=16;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="160" y="280" width="1350" height="480" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="form Lapor" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" edge="1" parent="1" source="a" target="b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="save" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" edge="1" parent="1" source="b" target="c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="handle status" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" edge="1" parent="1" source="d" target="c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="complete" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" edge="1" parent="1" source="d" target="e">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="transaction" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" edge="1" parent="1" source="e" target="c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
